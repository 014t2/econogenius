# Copia este fichero a .env y ajusta los valores
DATABASE_URL=sqlite:///./fincontrol.db
# DATABASE_URL=postgresql+psycopg://fincontrol:fincontrol@localhost:5432/fincontrol

# Genera una clave segura: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Secure=true funciona en http://localhost en navegadores modernos. En producción, siempre true (HTTPS).
COOKIE_SECURE=true
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_MB=10
# Crea las tablas automáticamente al arrancar (desarrollo). En producción usa: alembic upgrade head
AUTO_CREATE_TABLES=true
