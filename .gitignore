# ============================================================================
# €conogenius — .gitignore (Seguridad financiera, Python, Node y Docker)
# ============================================================================

# 1. Bases de datos locales y backups (¡NUNCA subir datos financieros reales a GitHub!)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*backup*.json
backend/data/

# 2. Extractos bancarios reales que puedas tener en la carpeta de trabajo
*.pdf
*.xls
*.xlsx
*.csv

# 3. Variables de entorno y secretos (sí se sube .env.example)
.env
.env.*
!.env.example
backend/.env
frontend/.env

# 4. Python / Backend (FastAPI)
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# 5. Node / Frontend (React + Vite)
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Sistema Operativo e IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
